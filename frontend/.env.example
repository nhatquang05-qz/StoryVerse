# ==========================================
# CẤU HÌNH CLOUDINARY (Quản lý lưu trữ ảnh)
# ==========================================

# Tên Cloud của bạn trên Cloudinary (lấy trong bảng điều khiển Dashboard của Cloudinary)
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Tên Upload Preset dùng để upload file trực tiếp từ Frontend lên Cloudinary (cần thiết lập "unsigned" trên Cloudinary)
VITE_CLOUDINARY_UPLOAD_PRESET=your_cloudinary_upload_preset


# ==========================================
# CẤU HÌNH API BACKEND
# ==========================================

# Đường dẫn cơ sở (Base URL) gọi đến Backend API của dự án
VITE_API_BASE_URL="http://localhost:3000/api"


# ==========================================
# CẤU HÌNH XÁC THỰC (Đăng nhập Mạng xã hội)
# ==========================================

# Client ID của Google (Lấy từ Google Cloud Console) dùng cho tính năng "Login with Google"
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# App ID của Facebook (Lấy từ Facebook Developers) dùng cho tính năng "Login with Facebook"
VITE_FACEBOOK_APP_ID=your_facebook_app_id_here