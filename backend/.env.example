# ==========================================
# CẤU HÌNH SERVER
# ==========================================
# Cổng chạy server backend
PORT=3000

# ==========================================
# CẤU HÌNH CƠ SỞ DỮ LIỆU (MySQL)
# ==========================================
# Địa chỉ máy chủ database (thường là localhost khi chạy cục bộ)
DB_HOST='localhost'

# Tên người dùng database (mặc định của XAMPP/MySQL thường là root)
DB_USER='root'

# Mật khẩu database (để trống nếu dùng XAMPP mặc định)
DB_PASSWORD=your_db_password_here

# Tên cơ sở dữ liệu của dự án
DB_NAME=your_db_name_here


# ==========================================
# CẤU HÌNH BẢO MẬT & XÁC THỰC
# ==========================================
# Chuỗi bí mật dùng để mã hóa và giải mã JSON Web Token (JWT)
JWT_SECRET=your_jwt_secret_key_here_or_random_string

# Client ID của Google dùng cho xác thực Backend (nếu có verify token)
GOOGLE_CLIENT_ID=your_google_client_id_here


# ==========================================
# CẤU HÌNH CLOUDINARY (Lưu trữ ảnh/media)
# ==========================================
# Thông tin lấy từ Dashboard tài khoản Cloudinary của bạn
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret


# ==========================================
# CẤU HÌNH AI CHATBOT (Groq)
# ==========================================
# API Key của Groq dùng để tích hợp mô hình ngôn ngữ AI
GROQ_API_KEY=your_groq_api_key_here


# ==========================================
# CẤU HÌNH THANH TOÁN (VNPay)
# ==========================================
# Mã Website của bạn trên hệ thống VNPay (Terminal ID)
VNP_TMN_CODE=your_vnp_tmn_code_here

# Chuỗi bí mật (Hash Secret) dùng để tạo mã checksum bảo mật của VNPay
VNP_HASH_SECRET=your_vnp_hash_secret_here


# ==========================================
# CẤU HÌNH EMAIL (Gửi thư, OTP, Newsletter, v.v.)
# ==========================================
# (Tuỳ thuộc vào thư viện bạn dùng như Nodemailer, sử dụng 1 trong 2 cấu hình dưới hoặc cả 2)

# Cấu hình SMTP Host (ví dụ: smtp.gmail.com)
EMAIL_HOST=your_smtp_host
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password

# Tài khoản gửi email chính (thường dùng Gmail App Password)
MAIL_USER=your_gmail_address@gmail.com
MAIL_APP_PASSWORD=your_16_digit_app_password_here